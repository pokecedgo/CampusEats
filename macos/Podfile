platform :osx, '11.0'  # Updated deployment target to 11.0

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'  # Updated to 11.0
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'COCOAPODS=1',
        'FLUTTER_BUILD_NAME=1.0.0',
        'FLUTTER_BUILD_NUMBER=1'
      ]
      
      # Expanded framework search paths
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = [
        '$(inherited)',
        '${PODS_ROOT}/../Flutter/ephemeral',
        '${PODS_XCFRAMEWORKS_BUILD_DIR}/Flutter',
        '${PODS_CONFIGURATION_BUILD_DIR}/FlutterMacOS',
        '${PODS_ROOT}/../../flutter/bin/cache/artifacts/engine/darwin-x64'
      ].uniq
      
      # Ensure proper header search paths
      config.build_settings['HEADER_SEARCH_PATHS'] ||= [
        '$(inherited)',
        '${PODS_ROOT}/Headers/Public',
        '${PODS_CONFIGURATION_BUILD_DIR}/FlutterMacOS'
      ]
      
      # Handle architecture-specific settings
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['VALID_ARCHS'] = 'arm64 x86_64'
      
      # Disable script phase analysis
      if target.respond_to?(:build_phases)
        target.build_phases.each do |phase|
          if phase.respond_to?(:name) && phase.name.start_with?("Create Symlinks")
            phase.always_out_of_date = '1'  # Changed from true to '1'
          end
        end
      end
    end
  end
end
